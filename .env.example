# Read-only Ethereum mainnet RPC endpoint
RPC_URL=https://YOUR_ETHEREUM_MAINNET_RPC_URL

# Required only for executor simulation; use a dedicated wallet.
EXECUTOR_ADDRESS=0xYOUR_DEPLOYED_EXECUTOR_CONTRACT
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Safe defaults: executor only simulates and never broadcasts.
LIVE_TRADING=false
CONFIRM_LIVE_TRADING=
SLIPPAGE_BPS=30
GAS_BUFFER_BPS=12000
MIN_PROFIT_BASE_UNITS=1000000000000000

# Optional Telegram alerts (scanner only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base Sepolia sponsored UserOperation test (testnet only)
BASE_SEPOLIA_RPC_URL=https://YOUR_BASE_SEPOLIA_RPC_URL
PIMLICO_API_KEY=YOUR_PIMLICO_API_KEY
# This key must control the ERC-4337 smart account; never commit the real value.
WALLET_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY
EXECUTOR_ADDRESS=0xYOUR_BASE_SEPOLIA_EXECUTOR
ASSET_ADDRESS=0xYOUR_TEST_ASSET
INTERMEDIATE_TOKEN_ADDRESS=0xYOUR_TEST_INTERMEDIATE_TOKEN
BUY_ROUTER_ADDRESS=0xYOUR_TEST_BUY_ROUTER
SELL_ROUTER_ADDRESS=0xYOUR_TEST_SELL_ROUTER
# All numeric values below are raw token base units, not human-readable decimals.
LOAN_AMOUNT=100000000000000000
MIN_INTERMEDIATE_OUT=1
MIN_FINAL_OUT=1
MIN_PROFIT_BASE_UNITS=1
# Default is simulation only. true submits a real Base Sepolia testnet UserOperation.
SPONSORED_SEND=false
